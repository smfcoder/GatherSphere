# Database
POSTGRES_USER=db_admin
POSTGRES_PASSWORD=your-db-password
POSTGRES_DB=society_app
DATABASE_URL=postgresql://db_admin:your-db-password@db:5432/society_app

# JWT
SECRET_KEY=your-jwt-secret

# Keycloak OIDC
KEYCLOAK_ISSUER=http://localhost:8080/realms/society
KEYCLOAK_AUDIENCE=account
AUTH_KEYCLOAK_ID=nextjs-client
AUTH_KEYCLOAK_SECRET=your-keycloak-client-secret
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/society

# NextAuth
AUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# API
API_BASE_URL=http://backend:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
